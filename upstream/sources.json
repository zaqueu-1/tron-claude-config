{
  "$comment": "MAINTAINER ONLY — never shipped (package.json `files`). Provenance + pins for every upstream this package interprets. `watch` = paths we consume (diffs here are relevant); `discover` = dirs where new upstream items appear (reported as adoption candidates). Update pins only after porting: `npm run upstream:watch -- --accept <id>` (tron-kit: `npm run sync:tron-kit -- --ref <sha>`).",
  "brandTerms": [
    "\\bimpeccable\\b",
    "\\bemil\\b",
    "kowalski",
    "leonxlnx",
    "taste-?skill",
    "\\bstitch\\b",
    "karpathy",
    "\\bcaveman\\b",
    "\\bgsd\\b",
    "pbakaus",
    "\\behmo\\b",
    "platform-design-skills",
    "everything-claude-code"
  ],
