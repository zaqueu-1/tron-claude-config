    {
      "id": "tron-design",
      "repo": "https://github.com/pbakaus/impeccable.git",
      "ref": "cd12f8660e2dde57b9615c8a6b8ea674101f9cfc",
      "version": "skill-v4.3.1",
      "license": "Apache-2.0",
      "kind": "content+runtime",
      "status": "rewritten+wrapped",
      "phase": 2,
      "tron": "managed/skills/tron-design/ + managed/hooks/",
      "watch": [
        ".claude/skills/impeccable/**",
        ".claude/agents/**",
        ".cursor/hooks.json",
        "NOTICE.md",
        "ENGINE_VERSION"
      ],
      "discover": [
        ".claude/skills",
        ".claude/agents"
      ],
      "notes": "Skill text and reference/ are tron rewrites. The compiled engine (scripts/impeccable launcher, scripts/bin/, live-browser assets, data/) stays vendored and runs only through scripts/tron-design (no telemetry, no self-update, rebranded output). Port engine bumps by replacing those files and checking the reference/ filenames the binary names (new-work, init, live, visualize, ios, android).",
      "originality": {
        "upstream": [
          ".claude/skills/impeccable/**/*.md",
          ".claude/agents/*.md"
        ],
        "tron": [
          "managed/skills/tron-design"
        ],
        "exclude": [
          "managed/skills/tron-design/scripts"
        ],
        "protocol": {
          "verbs": "scripts/impeccable(?:\\.cmd)? ([a-z][a-z-]+)",
          "flags": true,
          "ignore": [
            "craft"
          ]
        }
      }
    },
    {
