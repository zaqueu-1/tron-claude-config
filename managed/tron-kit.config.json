{
  "upstream": {
    "repo": "https://github.com/affaan-m/ECC.git",
    "ref": "38a7ebbe3294be9bfda5612c6d696742ade6fbb2"
  },
  "include": [
    "commands",
    "skills",
    "hooks",
    "scripts",
    "rules",
    "schemas",
    "manifests",
    "config",
    "mcp-configs",
    ".mcp.json",
    "LICENSE",
    "VERSION"
  ],
  "exclude": [
    "hooks/README.md",
    "hooks/memory-persistence/**",
    "hooks/*.bak",
    "**/.DS_Store",
    "**/__pycache__/**",
    "**/node_modules/**"
  ],
  "hooks": {
    "file": "hooks/hooks.json",
    "stripMatcherKeys": [
      "id",
      "description"
    ],
    "keep": [
      "pre:bash:block-no-verify",
      "pre:config-protection",
      "post:edit:accumulate",
      "stop-format-typecheck",
      "check-console-log"
    ],
    "derive": [
      {
        "from": [
          "pre:config-protection",
          "scripts/hooks/config-protection.js"
        ],
        "id": "pre:bash:block-no-verify",
        "script": "scripts/hooks/block-no-verify.js",
        "matcher": "Bash",
        "event": "PreToolUse"
      }
    ]
  },
  "rewrites": [
    {
      "id": "inline-resolver-plugin-roots",
      "files": [
        "hooks/hooks.json",
        "scripts/lib/resolve-ecc-root.js",
        "commands/*.md"
      ],
      "find": "var s=['ecc','ecc@ecc','marketplaces/ecc','everything-claude-code','everything-claude-code@everything-claude-code','marketplaces/everything-claude-code']",
      "replace": "var s=['tron-kit','tron-kit@tron','marketplaces/tron']",
      "minMatches": 30
    },
    {
      "id": "inline-resolver-cache-marketplaces",
      "files": [
        "hooks/hooks.json",
        "scripts/lib/resolve-ecc-root.js",
        "commands/*.md"
      ],
      "find": "var g=['ecc','everything-claude-code']",
      "replace": "var g=['tron']",
      "minMatches": 30
    },
    {
      "id": "resolver-module-slugs",
      "files": [
        "scripts/lib/resolve-ecc-root.js"
      ],
      "find": "const CURRENT_PLUGIN_SLUG = 'ecc';\nconst LEGACY_PLUGIN_SLUG = 'everything-claude-code';\nconst CURRENT_PLUGIN_HANDLE = `${CURRENT_PLUGIN_SLUG}@${CURRENT_PLUGIN_SLUG}`;\nconst LEGACY_PLUGIN_HANDLE = `${LEGACY_PLUGIN_SLUG}@${LEGACY_PLUGIN_SLUG}`;\nconst PLUGIN_CACHE_SLUGS = [CURRENT_PLUGIN_SLUG, LEGACY_PLUGIN_SLUG];\nconst PLUGIN_ROOT_SEGMENTS = [\n  [CURRENT_PLUGIN_SLUG],\n  [CURRENT_PLUGIN_HANDLE],\n  ['marketplaces', CURRENT_PLUGIN_SLUG],\n  [LEGACY_PLUGIN_SLUG],\n  [LEGACY_PLUGIN_HANDLE],\n  ['marketplaces', LEGACY_PLUGIN_SLUG],\n];",
      "replace": "const CURRENT_PLUGIN_SLUG = 'tron-kit';\nconst MARKETPLACE_SLUG = 'tron';\nconst CURRENT_PLUGIN_HANDLE = `${CURRENT_PLUGIN_SLUG}@${MARKETPLACE_SLUG}`;\nconst PLUGIN_CACHE_SLUGS = [MARKETPLACE_SLUG];\nconst PLUGIN_ROOT_SEGMENTS = [\n  [CURRENT_PLUGIN_SLUG],\n  [CURRENT_PLUGIN_HANDLE],\n  ['marketplaces', MARKETPLACE_SLUG],\n];",
      "minMatches": 1
    },
    {
      "id": "session-handoff-replaces-save-session",
      "files": [
        "skills/prompt-optimizer/SKILL.md"
      ],
      "find": "/save-session",
      "replace": "/session-handoff",
      "minMatches": 1
    },
    {
      "id": "a11y-react-rule",
      "files": [
        "rules/react/patterns.md"
      ],
      "find": "For accessibility see `skills/accessibility/SKILL.md`.",
      "replace": "For accessibility see the `impeccable` skill (`audit`, `harden`).",
      "minMatches": 1
    },
    {
      "id": "a11y-react-patterns-crosslink",
      "files": [
        "skills/react-patterns/SKILL.md"
      ],
      "find": "[skills/accessibility/SKILL.md](../accessibility/SKILL.md) covers WCAG criteria and pattern libraries",
      "replace": "the `impeccable` skill (`audit`, `harden`) covers WCAG criteria and accessibility hardening",
      "minMatches": 1
    },
    {
      "id": "a11y-react-testing-crosslink",
      "files": [
        "skills/react-testing/SKILL.md"
      ],
      "find": "[skills/accessibility/SKILL.md](../accessibility/SKILL.md) for the broader a11y testing playbook.",
      "replace": "the `impeccable` skill (`audit`, `harden`) for the broader a11y review.",
      "minMatches": 1
    },
    {
      "id": "a11y-skill-md-links",
      "files": [
        "skills/react-patterns/SKILL.md",
        "skills/react-performance/SKILL.md",
        "skills/react-testing/SKILL.md"
      ],
      "find": "[accessibility](../accessibility/SKILL.md)",
      "replace": "`impeccable` (audit, harden)",
      "minMatches": 3
    },
    {
      "id": "a11y-vue-patterns",
      "files": [
        "skills/vue-patterns/SKILL.md"
      ],
      "find": "- `accessibility` — ARIA, semantic HTML, focus management",
      "replace": "- `impeccable` (audit, harden) — ARIA, semantic HTML, focus management",
      "minMatches": 1
    },
    {
      "id": "a11y-mle-workflow",
      "files": [
        "skills/mle-workflow/SKILL.md"
      ],
      "find": "`browser-qa` / `accessibility`",
      "replace": "`browser-qa` / `impeccable` (audit)",
      "minMatches": 1
    },
    {
      "id": "a11y-mle-workflow-table",
      "files": [
        "skills/mle-workflow/SKILL.md"
      ],
      "find": "`browser-qa`, `accessibility`",
      "replace": "`browser-qa`, `impeccable` (audit)",
      "minMatches": 1
    },
    {
      "id": "run-with-flags-cursor-guard",
      "files": [
        "scripts/hooks/run-with-flags.js"
      ],
      "find": "  const sanitizeEcho = text => (truncated && text === raw ? '' : text);\n  if (truncated) {",
      "replace": "  const sanitizeEcho = text => (truncated && text === raw ? '' : text);\n\n  // Cursor rejects large pass-through echo as \"invalid JSON\"; pre-tool hooks are Claude Code-only, so under Cursor (`cursor_version`) answer \"no opinion\".\n  const isCursorPayload = () => { try { const p = JSON.parse(raw); return Boolean(p && typeof p === 'object' && p.cursor_version); } catch { return false; } };\n  if (hookId && hookId.startsWith('pre:') && isCursorPayload()) {\n    exitWithStdout('{}', 0);\n    return;\n  }\n\n  if (truncated) {",
      "minMatches": 1
    }
  ],
  "plugin": {
    "name": "tron-kit",
    "description": "Tron engineering kit for Claude Code: skills, commands, hooks, language rules, agent role briefs and MCP conventions managed by @tron/claude-config",
    "author": {
      "name": "tron"
    },
    "license": "MIT",
    "keywords": [
      "claude-code",
      "skills",
      "hooks",
      "rules",
      "tdd",
      "code-review",
      "security",
      "workflow"
    ]
  },
  "marketplace": {
    "name": "tron",
    "owner": {
      "name": "tron"
    },
    "description": "Tron-managed Claude Code plugins"
  },
